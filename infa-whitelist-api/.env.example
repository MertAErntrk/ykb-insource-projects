# Kopyalayın: Copy-Item .env.example .env
# .env git dışıdır; kimseyle paylaşılmaz, sohbete ya da e-postaya yapıştırılmaz.

# Veritabanı kullanıcısı
IWC_DB_USER=
# Özel karakter varsa tek tırnak içine alın: IWC_DB_PASSWORD='p@ss#1'
IWC_DB_PASSWORD=

# Veritabanının adresi. tnsnames.ora'daki girdide yazan HOST, PORT ve SERVICE_NAME ile:
#   IWC_DB_DSN=sunucu.adi:1521/SERVIS_ADI
# Girdi SERVICE_NAME yerine SID kullanıyorsa kısa biçim çalışmaz; tanımın tamamını tek satırda yazın:
#   IWC_DB_DSN="(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=sunucu.adi)(PORT=1521))(CONNECT_DATA=(SID=SID_ADI)))"
IWC_DB_DSN=

# Çağıranın X-API-Key başlığında göndereceği anahtar. Kimseden alınmaz, burada üretilir:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
# Virgülle birden çok anahtar yazılabilir. Her biri 32-128 karakter; yalnız harf, rakam, - ve _.
IWC_API_KEYS=

# Veritabanı Native Network Encryption istiyorsa Thin kip DPY-3001 hatası verir; Thick kipi açın.
# Oracle istemcisi PATH'te değilse dizinini de verin.
# Thick kipte bağlantı zaman aşımını DSN'e ekleyin: ...?transport_connect_timeout=5
# ya da tanımın içine (TRANSPORT_CONNECT_TIMEOUT=5).
# IWC_ORACLE_THICK=true
# IWC_ORACLE_THICK_LIB_DIR=C:\oracle\instantclient_19_20

# Veritabanı çağrısı zaman aşımı (ms) ve havuzdaki en çok bağlantı
# IWC_DB_CALL_TIMEOUT_MS=5000
# IWC_DB_POOL_MAX=4
