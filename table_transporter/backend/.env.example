# VeriKöprü ayarları. Bu dosyayı .env olarak kopyalayın; .env git'e girmez.
# Gizli alanlar (SECRET/KEY) bilerek boş: doldurulmazsa uygulama açılmaz.

# --- LDAP (Active Directory) ---
LDAP_SERVER_URI=ldaps://ldaps.kfs.local:636
LDAP_BASE_DN=OU=BTUsers,OU=GMUsers,OU=KFS,OU=Users,OU=KFS,DC=kfs,DC=local
LDAP_DOMAIN=KFS
# false = sertifika doğrulanmaz (CERT_NONE). LDAP_CA_FILE verilirse doğrulama açılır.
LDAP_TLS_VERIFY=false
LDAP_CA_FILE=
LDAP_TIMEOUT_SEC=10
# Virgülle ayrılmış grup listesi. Boş = herkes girebilir (Base DN içindeki kullanıcılar).
LDAP_ALLOWED_GROUPS=
# Yönetici grupları: tüm işleri ve temizliği görür.
LDAP_ADMIN_GROUPS=

# --- Ortam ---
# local | openshift
TT_ENV=local
# Derlenmiş frontend dizini (frontend/dist). Boşsa yalnız API sunulur.
TT_FRONTEND_DIST=
# tnsnames.ora dizini
TT_TNS_ADMIN=config
# Thick mod için Oracle Instant Client dizini (boş = Thin mod)
TT_ORACLE_THICK_LIB_DIR=

# --- Oturum ---
# En az 32 bayt, TT_ANON_HMAC_KEY'den FARKLI olmalı.
TT_SESSION_SECRET=
TT_SESSION_TTL_MIN=30
# localhost'ta (HTTP) false yapın; OpenShift'te true kalmalı.
TT_COOKIE_SECURE=true

# --- Anonimleştirme ---
# En az 32 bayt. Değişirse aynı veri farklı sonuç üretir (join bozulur); gizli tutun.
TT_ANON_HMAC_KEY=

# --- Taşıma ---
# En çok 5000000 (üstü reddedilir)
TT_ROW_LIMIT=5000000
TT_BATCH_ROWS=100000
TT_MAX_CONCURRENT_JOBS=2
TT_COUNT_TIMEOUT_SEC=60
# ZORUNLU: hedef olamayacak (yalnız kaynak, canlı) alias'lar, virgülle. Boşsa uygulama açılmaz.
TT_TARGET_DENY_ALIASES=

# --- Temizlik ---
TT_RETENTION_DAYS=7
TT_CHECK_INTERVAL_MIN=60
TT_SERVICE_ACCOUNTS_FILE=config/service_accounts.toml

# --- Depolama ---
TT_SQLITE_PATH=data/verikopru.db
