# Temizlik kontrolü için servis hesapları (yalnız sözlük okuma: ALL_OBJECTS / ALL_TABLES).
# Bu dosyanın kopyası config/service_accounts.toml git'e GİRMEZ; OpenShift'te Secret olarak bağlanır.

[default]
user = "SERVIS_KULLANICI"
password = "BURAYA_SIFRE"

# Alias'a özel hesap (varsa [default] yerine bu kullanılır)
[alias.DEMO_TEST]
user = "DEMO_TEST_SERVIS"
password = "BURAYA_SIFRE"
