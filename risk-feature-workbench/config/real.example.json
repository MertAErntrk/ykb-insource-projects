{
  "mode": "real",
  "allow_real_connections": false,
  "oracle": {
    "source_database": "",
    "environment": "",
    "container": "",
    "schemas": [],
    "user_env": "RISK_ORACLE_USER",
    "password_env": "RISK_ORACLE_PASSWORD",
    "dsn_env": "RISK_ORACLE_DSN",
    "wallet_dir_env": "RISK_ORACLE_WALLET_DIR",
    "wallet_password_env": "RISK_ORACLE_WALLET_PASSWORD",
    "notes": "DSN veya host/port/service bilgilerini Oracle sürücüsünün DSN biçiminde ortam değişkenine girin; sırları bu dosyaya yazmayın."
  },
  "llm": {
    "endpoint": "",
    "allowed_hosts": [],
    "contract": "",
    "model": "",
    "model_version": "",
    "api_key_env": "RISK_LLM_API_KEY",
    "timeout_seconds": 30,
    "max_retries": 1,
    "max_candidates": 8,
    "max_chars": 1800,
    "max_output_tokens": 1200,
    "notes": "Kurumdan tam endpoint ve sözleşmeyi doğrulayın. openai_chat yalnız doğrulanınca seçilir. Model adı varsayılmamıştır."
  },
  "embedding": {
    "endpoint": "",
    "allowed_hosts": [],
    "model": "",
    "model_version": "",
    "dimensions": 0,
    "request_template": {},
    "response_path": "",
    "api_key_env": "RISK_EMBEDDING_API_KEY",
    "timeout_seconds": 30,
    "max_retries": 1,
    "max_batch": 16,
    "notes": "Yol, payload, response_path ve boyut gerçek API sözleşmesine göre doldurulur. OpenAI uyumluluğu varsayılmamıştır."
  },
  "retrieval": {
    "limit": 8,
    "expanded_limit": 24,
    "pool_size": 30,
    "lexical_k": 40,
    "semantic_k": 30,
    "shortlist_embed": 10,
    "background_size": 128,
    "gate": {
      "z_min": 2.5,
      "c_min": 0.5,
      "z_strong": 4.0,
      "c_low": 0.3,
      "margin": 1.5,
      "lexical_min_coverage": 0.8,
      "lexical_min_tokens": 2,
      "max_shown": 3,
      "max_rejected": 5,
      "require_subject": true
    }
  },
  "naming": {
    "windows": {
      "LM": "last_month",
      "LW": "last_week",
      "L2W": "last_2_weeks",
      "L3M": "last_3_months"
    }
  },
  "notes": "config/real.json adıyla kopyalayın (git dışında tutulur). Gerçek mod ve bağlantı izni açıkça seçilmeden bağlantı kurulmaz. TLS doğrulaması kapatılmaz."
}
